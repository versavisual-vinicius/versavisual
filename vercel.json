{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/segmentos/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/ativacoes-e-eventos",
      "destination": "/ativacoes-eventos",
      "permanent": true
    },
    {
      "source": "/eventos",
      "destination": "/ativacoes-eventos",
      "permanent": true
    },
    {
      "source": "/ativacoes",
      "destination": "/ativacoes-eventos",
      "permanent": true
    },
    {
      "source": "/moda",
      "destination": "/moda-campanhas",
      "permanent": true
    },
    {
      "source": "/campanhas",
      "destination": "/moda-campanhas",
      "permanent": true
    },
    {
      "source": "/artistas",
      "destination": "/artistas-videoclipes",
      "permanent": true
    },
    {
      "source": "/videoclipes",
      "destination": "/artistas-videoclipes",
      "permanent": true
    },
    {
      "source": "/musica",
      "destination": "/artistas-videoclipes",
      "permanent": true
    },
    {
      "source": "/posicionamento",
      "destination": "/posicionamento-profissional",
      "permanent": true
    },
    {
      "source": "/profissional",
      "destination": "/posicionamento-profissional",
      "permanent": true
    },
    {
      "source": "/corporativo",
      "destination": "/posicionamento-profissional",
      "permanent": true
    },
    {
      "source": "/lifestyle",
      "destination": "/imagem-pessoal-lifestyle",
      "permanent": true
    },
    {
      "source": "/imagem-pessoal",
      "destination": "/imagem-pessoal-lifestyle",
      "permanent": true
    },
    {
      "source": "/pessoal",
      "destination": "/imagem-pessoal-lifestyle",
      "permanent": true
    },
    {
      "source": "/casamento",
      "destination": "/casamentos",
      "permanent": true
    },
    {
      "source": "/gestante",
      "destination": "/gestantes",
      "permanent": true
    },
    {
      "source": "/maternidade",
      "destination": "/gestantes",
      "permanent": true
    },
    {
      "source": "/hotelaria",
      "destination": "/hotelaria-lifestyle",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
